PORT=5000
# Atlas (production): mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/snail_taxi?retryWrites=true&w=majority
# Local Docker: run `docker compose up -d` then use:
MONGODB_URI=mongodb://127.0.0.1:27017/snail_taxi
JWT_SECRET=replace_with_long_random_secret

# Stripe sandbox keys
STRIPE_SECRET_KEY=sk_test_xxx

# Razorpay sandbox keys
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# Firebase Admin (for verifying ID tokens and FCM)
# Preferred: path to the JSON from Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json
# Or set GOOGLE_APPLICATION_CREDENTIALS to the same path (Google standard).
#
# Alternative: inline PEM (one line, use \n between lines — must be valid PEM)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
